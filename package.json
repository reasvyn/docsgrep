{
  "name": "@anovise/docsgrep",
  "version": "0.2.1",
  "description": "MCP Server to explore local and remote documentation and README files",
  "type": "module",
  "bin": {
    "docsgrep": "build/index.js"
  },
  "scripts": {
    "build": "tsc",
    "prepare": "npm run build",
    "start": "node ./build/index.js",
    "dev": "ts-node-esm src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "docs",
    "documentation"
  ],
  "author": "Reasvyn <reasvyn@gmail.com>",
  "license": "ISC",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "glob": "^10.0.0",
    "simple-git": "^3.22.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.13",
    "@types/node": "^20.0.0",
    "rimraf": "^5.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3",
    "vitest": "^4.1.5"
  }
}
