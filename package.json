{
  "name": "docsgrep-monorepo",
  "private": true,
  "workspaces": ["packages/*"],
  "type": "module",
  "scripts": {
    "build": "bun run --filter docsgrep build",
    "dev": "bun run --filter docsgrep dev",
    "test": "bun run --filter docsgrep test",
    "test:watch": "bun run --filter docsgrep test:watch",
    "test:coverage": "bun run --filter docsgrep test:coverage",
    "lint": "bun run --filter docsgrep lint",
    "audit": "bun run --filter docsgrep audit",
    "bugs": "bun run --filter docsgrep bugs",
    "docs:check": "bun run --filter docsgrep docs:check",
    "docs:stale": "bun run --filter docsgrep docs:stale",
    "release": "bun run --filter docsgrep release"
  }
}
